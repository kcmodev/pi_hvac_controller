# Copy to .env and fill in. See the README for how to obtain these values.

# Google Device Access (Smart Device Management API)
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=
NEST_REFRESH_TOKEN=
NEST_PROJECT_ID=
NEST_DEVICE_ID=

# Optional, shown with their defaults
# HOST=0.0.0.0
# PORT=5000
# SPRAY_DB_PATH=db.json

# Uncomment to simulate the GPIO pins when not running on a Raspberry Pi
# GPIOZERO_PIN_FACTORY=mock
# GPIOZERO_MOCK_PIN_CLASS=mockpwmpin
